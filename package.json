{
  "name": "online-mahjong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "predev": "pnpm prisma:migrate:deploy",
    "dev": "pnpm --parallel --filter server --filter web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "mkdir -p data && DATABASE_URL=file:../data/dev.db prisma migrate dev",
    "prisma:migrate:deploy": "mkdir -p data && DATABASE_URL=file:../data/dev.db prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
