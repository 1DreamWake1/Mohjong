DATABASE_URL="file:../data/dev.db"
HOST="0.0.0.0"
PORT="3000"
SHUTDOWN_TIMEOUT_MS="10000"
AUTH_TOKEN_SECRET="change-this-to-a-long-random-value"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"

# SQLite 备份：BACKUP_DIR 为备份目录，BACKUP_KEEP 为保留数量，
# BACKUP_ON_BOOT 控制在容器启动迁移前是否自动备份（1 开启 / 0 关闭）。
BACKUP_DIR="data/backups"
BACKUP_KEEP="5"
BACKUP_ON_BOOT="1"

# 安全基线：
# CORS_ORIGIN 为允许跨域的来源白名单（逗号分隔）；同源部署（nginx）可留空。
CORS_ORIGIN=""
AUTH_COOKIE_NAME="mahjong_session"
AUTH_COOKIE_SECURE="1"
TRUST_PROXY="1"
# 请求体上限（字节），默认 64KB。
BODY_LIMIT_BYTES="65536"
# 登录限流：窗口内最大尝试次数与窗口毫秒数。
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_MS="60000"
# Socket 连接限流与游戏动作限流。
SOCKET_CONNECTION_RATE_LIMIT_MAX="20"
SOCKET_CONNECTION_RATE_LIMIT_WINDOW_MS="60000"
SOCKET_ACTION_RATE_LIMIT_MAX="30"
SOCKET_ACTION_RATE_LIMIT_WINDOW_MS="10000"

# Docker Compose overrides DATABASE_URL, HOST and PORT internally.
# AUTH_TOKEN_SECRET 在生产环境必须为至少 32 字符的随机值，否则 Server 拒绝启动。
WEB_PORT="8080"
